{
  "name": "drift-cab-booking",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "next build && tsc --noEmit -p server/tsconfig.json",
    "start": "concurrently -k -n web,api -c green,blue \"npm:start:web\" \"npm:start:api\"",
    "start:web": "next start",
    "start:api": "tsx server/src/index.ts"
  },
  "dependencies": {
    "@clerk/express": "^1.7.0",
    "@clerk/nextjs": "^6.31.0",
    "@next/env": "^15.2.0",
    "@stripe/react-stripe-js": "^3.9.0",
    "@stripe/stripe-js": "^7.9.0",
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^18.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0"
  }
}
